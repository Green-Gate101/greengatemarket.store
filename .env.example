# Green Gate — environment configuration
# Copy to .env for local development; every value is also set per-environment on Vercel.

# Required — Prisma database. Local SQLite file; on Vercel use file:/tmp/greengate.db
# (schema is created at runtime) or a hosted Postgres/MySQL connection string.
DATABASE_URL=file:./db/custom.db

# Required — stable secret for signed session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Required — administrator account provisioned automatically on first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Search (Algolia). Without these the catalogue falls back to database search.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
# Optional least-privilege search-only key used for queries (falls back to the admin key).
ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX_NAME=products

# Transactional email (Resend). Without it email delivery is disabled; nothing else breaks.
RESEND_API_KEY=
RESEND_FROM=Green Gate <onboarding@resend.dev>

# Durable hosted Postgres (Supabase/Neon integration vars). When present on the
# build host, scripts/prepare-db.sh pushes the schema there and the runtime
# connects to it instead of an ephemeral file: DATABASE_URL (fail-safe: any
# push failure falls back to SQLite exactly as before). Locally leave these
# unset to keep SQLite development untouched.
# POSTGRES_PRISMA_URL=      # pooled — preferred for serverless runtime traffic
# POSTGRES_URL=             # plain — runtime fallback
# POSTGRES_URL_NON_POOLING= # direct — used by the build-time schema push

# Courier rates (The Courier Guy / Ship Logic v2 gateway).
# Live city-pair quotes work WITHOUT any credential (TCG public prepaid rate
# card, account 12345). An optional merchant Access Token switches quotes to
# that merchant's negotiated rates and is required for label creation — get it
# from the Ship Logic portal (portal.thecourierguy.co.za) or TCG support.
# NOTE: the old api.thecourierguy.co.za host no longer exists (NXDOMAIN).
COURIER_GUY_API_KEY=
# Optional override of the prepaid rate-card account used for public quotes.
COURIER_GUY_ACCOUNT_ID=12345

# Google sign-in (optional — activates the Google button when both are present).
# Redirect URI to allow in the Google Cloud console: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — absolute site URL used only for metadata defaults.
# NEXTAUTH_URL=
