# Green Gate — environment configuration
# Copy to .env for local development; every value is also set per-environment on Vercel.

# Required — Prisma database. Local SQLite file; on Vercel use file:/tmp/greengate.db
# (schema is created at runtime) or a hosted Postgres/MySQL connection string.
DATABASE_URL=file:./db/custom.db

# Required — stable secret for signed session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Required — administrator account provisioned automatically on first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Search (Algolia). Without these the catalogue falls back to database search.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
# Optional least-privilege search-only key used for queries (falls back to the admin key).
ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX_NAME=products

# Transactional email (Resend). Without it email delivery is disabled; nothing else breaks.
RESEND_API_KEY=
RESEND_FROM=Green Gate <onboarding@resend.dev>

# Durable hosted Postgres (Supabase/Neon integration vars). When present on the
# build host, scripts/prepare-db.sh pushes the schema there and the runtime
# connects to it instead of an ephemeral file: DATABASE_URL (fail-safe: any
# push failure falls back to SQLite exactly as before). Locally leave these
# unset to keep SQLite development untouched.
# POSTGRES_PRISMA_URL=      # pooled — preferred for serverless runtime traffic
# POSTGRES_URL=             # plain — runtime fallback
# POSTGRES_URL_NON_POOLING= # direct — used by the build-time schema push

# Courier rates (The Courier Guy / Ship Logic v2 gateway).
# Live city-pair quotes work WITHOUT any credential (TCG public prepaid rate
# card, account 12345). An optional merchant Access Token switches quotes to
# that merchant's negotiated rates and is required for label creation — get it
# from the Ship Logic portal (portal.thecourierguy.co.za) or TCG support.
# NOTE: the API host is api.portal.thecourierguy.co.za (the old
# api.thecourierguy.co.za host no longer exists — NXDOMAIN).
COURIER_GUY_API_KEY=
# Optional override of the prepaid rate-card account used for public quotes.
COURIER_GUY_ACCOUNT_ID=12345

# Google sign-in (optional — activates the Google button when both are present).
# Redirect URI to allow in the Google Cloud console: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strongly recommended in production — the absolute site URL. Beyond metadata,
# it anchors account-email links (password resets, verification) and several
# API callbacks; without it those links echo the request Host header, so a
# misbehaving proxy could point them at the wrong host. Set it to the real
# domain (e.g. https://greengatemarket.store).
NEXTAUTH_URL=

# Cron protection (REQUIRED on Vercel deployments — both cron routes fail
# closed without it). Any long random string; sent as Authorization Bearer by
# vercel.json scheduled jobs.
CRON_SECRET=

# Shared rate limiting (Upstash Redis REST). Strongly recommended in
# production: without these, sign-in / reset / checkout / payment limits fall
# back to PER-INSTANCE in-memory ceilings, so an attacker spread across
# serverless instances gets N× the attempts. Free tier is enough.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# In-app payments (GGPay). GGPAY_ACQUIRER_KEY switches the engine to live mode
# once a production acquirer is wired into chargeCard() — without it the
# engine stays in honest test mode and deployed builds refuse every card.
# GGPAY_ALLOW_SANDBOX=1 additionally permits the sandbox card form outside
# local development (test deployments only — production always refuses).
GGPAY_ACQUIRER_KEY=
# GGPAY_ALLOW_SANDBOX=
# Platform commission percentage taken on in-app sales (default 5).
# GG_PLATFORM_FEE_PERCENT=5

# Seller subscriptions — Green Gate's own Yoco account (platform key, secret).
YOCO_PLATFORM_SECRET_KEY=
# Optional non-production override of the Yoco API base URL.
# YOCO_API_BASE=

# Seller-owned gateway sandbox flags (seller credentials themselves are stored
# encrypted in the database, never in env).
# PAYFAST_SANDBOX=1
# OZOW_IS_TEST=1

# Operational knobs.
# UNPAID_ORDER_CANCEL_DAYS=7      # auto-cancel unpaid orders after N days
# ADMIN_CONSOLE_URL=              # links shown to sellers (defaults to https://admin.greengatemarket.store)

# Product photo backgrounds (optional remove.bg integration for busy photos).
# REMOVE_BG_API_KEY=
# REMOVE_BG_SIZE=auto             # preview | auto | full | <WxH>
# PRODUCT_IMAGE_AI_BG=off         # set to 'off' to disable the AI background path

# S3-compatible image storage (optional — e.g. Cloudflare R2). Without it
# images are served from the database.
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=
