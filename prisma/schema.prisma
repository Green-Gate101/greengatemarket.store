generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // scrypt hash; null for OAuth-only accounts
  name          String?
  image         String?
  role          String    @default("BUYER") // BUYER | SELLER | ADMIN
  banned        Boolean   @default(false) // banned accounts cannot sign in or act
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  stores        Store[]
  orders        Order[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  productEvents ProductEvent[]
  orderEvents   OrderEvent[]
  auditLogs     AuditLog[]
  notifications Notification[]
  addresses     Address[]
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Application-managed tokens for email verification and password resets.
model AuthToken {
  id         String   @id @default(cuid())
  identifier String // user email
  token      String   @unique
  purpose    String // email_verify | password_reset
  expires    DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([identifier, purpose])
}

// ---------------------------------------------------------------------------
// Categories (database-driven taxonomy, admin-manageable)
// ---------------------------------------------------------------------------

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  parentId  String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Stores (seller accounts) — one store per user
// ---------------------------------------------------------------------------

model Store {
  id          String   @id @default(cuid())
  userId      String   @unique
  slug        String   @unique
  name        String
  description String?
  logoData    String?
  bannerData  String?
  location    String   @default("")
  phone       String   @default("")
  status      String   @default("pending") // pending (application under review) | active | suspended | declined
  createdAt   DateTime @default(now())

  // Denormalised store rating — maintained incrementally on every review
  // create/update so store pages never aggregate reviews at read time.
  ratingSum   Int      @default(0) // running sum of all review ratings (1–5)
  ratingCount Int      @default(0) // number of reviews counted in ratingSum

  // Seller application questionnaire (collected at onboarding, always editable
  // later via support). All optional so existing stores remain valid.
  businessName        String?
  businessType        String? // individual | sole_proprietor | partnership | pty | cc | other
  registrationNumber  String?
  taxNumber           String?
  idNumber            String? // SA ID / passport of the account owner (private)
  streetAddress       String?
  city                String?
  province            String? // SA province
  postalCode          String?
  websiteOrSocial     String?
  bankName            String?
  bankAccountType     String? // cheque | savings | transmission
  bankAccountNumber   String? // private
  bankBranchCode      String?
  bankAccountHolder   String?
  productCategories   String? // comma-separated slugs the store sells in
  sourcing            String? // own_make | wholesale | vintage | mixed
  monthlyVolume       String? // e.g. "1-20"
  dispatchDays        Int? // handling time before dispatch
  returnsDays         Int? // return window offered to buyers
  ownsBrand           Boolean  @default(false)
  confirmAge          Boolean  @default(false)
  confirmAccuracy     Boolean  @default(false)
  confirmTerms        Boolean  @default(false)
  applicationAt       DateTime? // when the questionnaire was completed
  applicationSignature String? // full name the applicant typed as their electronic signature

  // Seller payment-processor details (optional). payoutLink is the seller's
  // own hosted payment page (PayFast payment page, Yoco payment link,
  // SnapScan code page, Stripe payment link…) — buyers can pay there after
  // checkout; the order stays awaiting_payment until the seller confirms.
  payoutProvider      String? // bank_transfer (default) | payfast | yoco | mastercard | snapscan | stripe | other
  payoutLink          String? // https URL of the seller's own payment page
  payoutNote          String? // short instruction shown to buyers
  // In-system card payments: the seller's own Yoco secret key (AES-256-GCM
  // encrypted at rest via secret-box; NEVER returned by any API response).
  // When set, checkout creates a real Yoco card session per order (Mastercard
  // & Visa accepted) — no external link pasting required.
  yocoSecretKey       String?
  // Seller-owned PayFast account for IN-APP Onsite (lightbox) payments — the
  // buyer completes card / SiD instant EFT inside an in-app popup, never a
  // redirect. Merchant id/key appear in every PayFast form (public); the
  // passphrase is the real secret. Key fields are AES-256-GCM encrypted at
  // rest and never returned by any API response.
  payfastMerchantId     String? // seller's PayFast merchant ID (public in forms)
  payfastMerchantKeyEnc String? // seller's PayFast merchant key (encrypted at rest)
  payfastPassphraseEnc  String? // seller's PayFast passphrase (encrypted at rest)
  // Seller-owned Ozow account for IN-APP instant-EFT payments — the buyer
  // completes the bank selection inside an in-app frame, never a redirect.
  // Private key + API key are AES-256-GCM encrypted at rest and never
  // returned by any API response.
  ozowSiteCode          String? // seller's Ozow site code (public identifier)
  ozowPrivateKeyEnc     String? // seller's Ozow private key (encrypted at rest)
  ozowApiKeyEnc         String? // seller's Ozow API key for status checks (encrypted at rest)

  // Seller subscription (R499/month or R6 999/year; 30-day free trial from
  // approval). accessUntil is the effective end of selling access — the later
  // of the trial and the paid period — and every buyer-facing query filters on
  // it (sellingStoreWhere in src/lib/subscription.ts). billingExempt = free
  // access: stores owned by the administrator and stores the administrator
  // grants it to.
  trialEndsAt         DateTime?
  paidUntil           DateTime?
  accessUntil         DateTime?
  subscriptionPlan    String? // monthly | yearly (last paid plan)
  billingExempt       Boolean  @default(false)
  billingExemptNote   String?
  billingNotice       String? // last billing reminder sent: "soon:<iso>" | "expired:<iso>"

  // Trust: set when Green Gate has checked the seller's identity and bank
  // details (admin action store_verified). Buyers see a "Verified seller" badge.
  verifiedAt          DateTime?
  verifiedNote        String?

  // Pickup-point delivery the seller offers (null price = not offered). The
  // seller sets the price buyers pay and the delivery time they book with
  // PAXI (PEP stores) or Pudo (The Courier Guy lockers).
  pickupPaxiCents     Int?
  pickupPaxiEta       String? // e.g. "7-9" business days
  pickupPudoCents     Int?
  pickupPudoEta       String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]
  payouts  Payout[]
  subscriptionPayments SubscriptionPayment[]
  messages             SellerMessage[]
  discountCodes        DiscountCode[]

  @@index([status]) // catalogue joins filter active stores on every listing query
  @@index([status, accessUntil]) // catalogue: active + subscription still running
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id              String   @id @default(cuid())
  storeId         String
  categoryId      String?
  name            String
  slug            String   @unique
  description     String
  brand           String?
  condition       String   @default("new") // new | refurbished | pre_loved
  tags            String? // comma separated
  status          String   @default("pending_review") // draft | pending_review | approved | rejected | disabled | archived
  moderationNote  String?
  priceCents      Int
  salePriceCents  Int?
  currency        String   @default("ZAR")
  stock           Int      @default(0) // used when no variants exist
  weightGrams     Int      @default(1000)
  // Declared parcel size (cm) — The Courier Guy charges on the greater of
  // actual vs volumetric weight, so sellers declare the box the item ships in.
  lengthCm        Int      @default(30)
  widthCm         Int      @default(25)
  heightCm        Int      @default(15)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  reviews       Review[]
  events        ProductEvent[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([storeId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([priceCents])
  // Composite for the hottest storefront listing query (status='approved'
  // ORDER BY createdAt DESC) and category browse at marketplace scale.
  @@index([status, createdAt])
  @@index([status, categoryId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  dataUrl   String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  attributes String // JSON: {"size":"M","colour":"Black"}
  priceCents Int? // optional override
  stock      Int     @default(0)
  imageData  String?
  active     Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
  @@index([productId, active]) // in-stock OR-clause on every listing query
}

// ---------------------------------------------------------------------------
// Cart / wishlist (server-side, per user)
// ---------------------------------------------------------------------------

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String   @id @default(cuid())
  number          String   @unique // human-friendly e.g. GG-8F3K2A
  buyerId         String?
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  address         String
  shippingMethod  String
  shippingCents   Int
  subtotalCents   Int
  totalCents      Int
  currency        String   @default("ZAR")
  status          String   @default("pending_payment")
  paymentProvider String   @default("bank_transfer")
  paymentStatus   String   @default("awaiting_payment") // awaiting_payment | claimed | paid | refunded
  paymentRef      String?
  yocoCheckoutId  String? // Yoco Checkout API session id for in-system card payment verification
  ozowTransactionId String? // Ozow transaction id for in-app instant-EFT payment verification
  idempotencyKey  String?  @unique
  deliveryLat     Float?   // exact GPS pin handed to The Courier Guy on every order
  deliveryLng     Float?
  deliveryAccuracyMeters Int? // GPS accuracy radius in metres when captured
  deliveryPinSource String? // gps | saved_default (where the pin came from)
  // Discount code the buyer used on this order (the seller's own code; the
  // seller funds it). totalCents = subtotalCents - discountCents + shippingCents.
  discountCodeId  String?
  discountCode    String?
  discountCents   Int      @default(0)
  // The Courier Guy: the exact service code chosen at checkout (e.g. tcg_lpf)
  // plus the booked shipment. Booked automatically once payment settles;
  // failures are recorded honestly and retried — booking never blocks money.
  shippingOptionCode String?
  courierTrackingRef String?
  courierShipmentId  Int?
  courierStatus      String?
  courierBookedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer  User?       @relation(fields: [buyerId], references: [id])
  store  Store       @relation(fields: [storeId], references: [id])
  storeId String
  items  OrderItem[]
  events OrderEvent[]
  payments Payment[]
  payout  Payout?
  discount DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  @@index([buyerId])
  @@index([storeId])
  @@index([createdAt])
  @@index([status])
  @@index([yocoCheckoutId]) // Yoco webhook/return lookup by stored checkout id
  @@index([status, paymentStatus, createdAt]) // cron scans + admin "awaiting payment" queue
  @@index([courierTrackingRef]) // tracking lookups + booking sweep
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  storeId         String
  name            String // snapshot at purchase time
  variantLabel    String? // snapshot e.g. "Size M / Black"
  quantity        Int
  unitPriceCents  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([storeId])
  @@index([productId]) // verified-purchase checks + product delete impact count
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  actorId   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1..5
  title     String?
  body      String
  verified  Boolean  @default(false) // computed server-side from real orders
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Analytics events (real user behaviour feeding seller dashboards)
// ---------------------------------------------------------------------------

model ProductEvent {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  guestId   String? // anonymous browser profile id (localStorage), merged on sign-in
  type      String // view | cart | wishlist | purchase | rec_click | published
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId, type, createdAt])
  @@index([userId, createdAt])
  @@index([guestId])
  @@index([type, createdAt]) // admin usage figures (last 30 days) without reading every event
}

// ---------------------------------------------------------------------------
// Recommendation engine state — the marketplace's persistent learning memory.
// One row per subject: 'model' (item-item co-occurrence, popularity, learned
// ensemble weights) and one row per user/guest affinity profile.
// ---------------------------------------------------------------------------

model RecommendationState {
  id        String   @id @default(cuid())
  scope     String   @unique // model | user:<id> | guest:<id>
  data      String // JSON snapshot
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Security audit trail (never exposed publicly)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  target     String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// In-app notifications (order events, payment confirmations, account notices)
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // order_placed | new_order | payment_confirmed | order_status | welcome | review_received
  title     String
  body      String
  link      String? // in-app hash route, e.g. /orders
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Saved delivery addresses — "always deliver here" locations (GPS or manual)
// ---------------------------------------------------------------------------

model Address {
  id             String    @id @default(cuid())
  userId         String
  label          String    @default("Home") // Home, Work, Mom's place…
  recipientName  String
  phone          String
  street         String
  city           String
  province       String
  postalCode     String
  latitude       Float?    // exact real-time GPS fix when captured
  longitude      Float?
  accuracyMeters Int?      // GPS accuracy radius in metres when captured
  locationSource String    @default("manual") // manual | gps
  isDefault      Boolean   @default(false) // "always deliver here"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Platform insights (admin) — real usage telemetry, nothing synthetic
// ---------------------------------------------------------------------------

model SearchLog {
  id        String   @id @default(cuid())
  term      String   // lower-cased, trimmed search phrase (max 120 chars)
  results   Int      @default(0) // how many products matched at search time
  createdAt DateTime @default(now())

  @@index([term])
  @@index([createdAt])
  @@index([results])
}

model ApiUsage {
  id      String @id @default(cuid())
  service String // resend | courier_guy | google_maps | algolia
  day     String // YYYY-MM-DD (UTC)
  count   Int    @default(0)

  @@unique([service, day])
}

// ---------------------------------------------------------------------------
// In-app payment system (GGPay) — Amazon/Takealot-style: the buyer pays the
// marketplace inside the app, the order confirms automatically, and each
// seller's earnings are queued as a payout to their configured payout method.
// ---------------------------------------------------------------------------

// One row per charge attempt (the audit trail of every payment try).
model Payment {
  id            String   @id @default(cuid())
  orderId       String
  provider      String   // ggpay_card | yoco | payfast | bank_transfer | admin
  method        String   @default("card") // card | bank_transfer
  status        String   // paid | failed | refunded
  amountCents   Int
  currency      String   @default("ZAR")
  reference     String   @unique // PAY-XXXXXXXX (becomes order.paymentRef when paid)
  cardBrand     String?  // visa | mastercard | amex (card payments only)
  cardLast4     String?  // last four digits only — full numbers are NEVER stored
  failureReason String?  // gateway decline reason when status = failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// Seller earnings per paid order: gross (product subtotal), marketplace fee,
// net to the seller, paid to their configured payout method (bank account).
model Payout {
  id          String    @id @default(cuid())
  sellerId    String    // Store.userId — denormalised for fast seller queries
  storeId     String
  orderId     String    @unique // exactly one payout per paid order
  grossCents  Int
  feeCents    Int
  netCents    Int
  feePercent  String    // e.g. "5.0" — the rate applied when created
  method      String    @default("bank_account") // bank_account | yoco | payfast
  destination String    // masked, e.g. "FNB ·· 1234 · T Mokoena"
  status      String    @default("pending") // pending | processing | paid
  reference   String    @unique // PO-XXXXXXXX
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([storeId]) // admin store-scoped payout views + include joins
  @@index([status])
  @@index([createdAt])
  // Seller dashboard payout list filters by seller + status.
  @@index([sellerId, status])
}

///
/// Always-on system watch (additive): one row per failing check, opened the
/// first time the check fails and closed automatically when it recovers.
/// Written by /api/cron/system-watch (Vercel Cron); surfaced in /api/monitor
/// and the admin console's live System Monitor view.
///
model MonitorIncident {
  id          String    @id @default(cuid())
  check       String    // failing service key, e.g. "database", "payments (marketplace PayFast)"
  status      String    @default("open") // open | resolved
  detail      String    // last failure detail (no credential values, ever)
  occurrences Int       @default(1) // consecutive failed runs while open
  openedAt    DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, openedAt])
  @@index([check, status])
}

// Seller subscription payments (Green Gate's own Yoco account). Financial
// records: never deleted with the store (Restrict) — the admin console tracks
// who paid, when and for which period.
model SubscriptionPayment {
  id             String    @id @default(cuid())
  storeId        String
  plan           String    // monthly | yearly
  amountCents    Int
  status         String    @default("pending") // pending | paid | failed | cancelled
  reference      String    @unique // SUB-XXXXXXXX
  yocoCheckoutId String?   @unique
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([status, createdAt])
}

// Text messages between the Green Gate administrator and a seller (one
// thread per store). Plain text only.
model SellerMessage {
  id        String    @id @default(cuid())
  storeId   String
  fromAdmin Boolean
  authorId  String?
  body      String
  readAt    DateTime? // when the other side read it
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([fromAdmin, readAt])
}

/// A seller's own discount code for their store's items (the seller funds it).
model DiscountCode {
  id               String    @id @default(cuid())
  storeId          String
  code             String // upper case, as buyers type it (A-Z, 0-9, dash)
  percentOff       Int? // 1-90 percent off the store's items, or…
  amountOffCents   Int? // …a fixed amount off them
  minSubtotalCents Int       @default(0)
  firstOrderOnly   Boolean   @default(false) // only a buyer's first paid order on Green Gate
  maxUses          Int? // total uses allowed (null = no limit)
  usedCount        Int       @default(0)
  expiresAt        DateTime?
  active           Boolean   @default(true) // the seller's on/off switch
  disabledByAdmin  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, code])
  @@index([code])
}
